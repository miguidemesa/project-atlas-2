# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas_marketplace

# Backend
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=atlas_marketplace;Username=postgres;Password=change-me
Jwt__SecretKey=generate-a-random-key-of-at-least-32-characters
Cors__Origins__0=http://localhost:3000
Storage__Provider=Local
Google__ClientId=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
