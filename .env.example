# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=atlas_marketplace

# Backend
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=atlas_marketplace;Username=postgres;Password=postgres
Jwt__SecretKey=CHANGE_ME_TO_256_BIT_SECRET_KEY_HERE
Jwt__Issuer=atlas-marketplace
Jwt__Audience=atlas-marketplace
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30
Google__ClientId=
Storage__Provider=Local
Storage__Local__Path=App_Data/uploads
Storage__PublicBaseUrl=http://localhost:5000/uploads
Cors__Origins__0=http://localhost:3000

# Market data ingestion (external card price feeds)
MarketData__Provider=None
MarketData__FxUsdPhp=58.5
# MarketData__Provider=PriceCharting
# MarketData__PriceCharting__ApiKey=your-key-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
